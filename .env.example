# Copy this to .env and fill in values

# Port to listen on (default: 8000)
PORT=8000

# Optional: Set to enable API key authentication
# Leave empty to allow open access (good for local dev)
API_KEY=your-secret-key-here

# Comma-separated allowed origins for CORS
# Use * to allow all (default)
ALLOWED_ORIGINS=*

# Audio cache directory (default: system temp dir)
CACHE_DIR=/tmp/ytm_audio_cache

# Max number of songs to keep cached on disk
CACHE_MAX_FILES=100
