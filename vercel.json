{
  "version": 2,
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60,
      "includeFiles": "artifacts/api-server/**"
    },
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "artifacts/api-server/**"
    }
  }
}