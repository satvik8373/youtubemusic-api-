{
  "buildCommand": "pnpm --filter @workspace/music-app run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60,
      "includeFiles": "artifacts/api-server/**"
    },
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "artifacts/api-server/**"
    }
  }
}